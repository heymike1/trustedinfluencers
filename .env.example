APP_NAME="Trusted Influencers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trustedinfluencers
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_OG_IMAGE=/og.png
APP_TWITTER_HANDLE=

DATAFAST_WEBSITE_ID=dfid_mWBEhF5ENbpUJJFPlCs7l
DATAFAST_DOMAIN=trustedinfluencers.co

# Social connectors: "fake" works fully offline, "live" uses the official APIs below.
SOCIAL_CONNECTOR_DRIVER=fake
SOCIAL_SYNC_CONTENT_LIMIT=50
SOCIAL_SYNC_MANUAL_COOLDOWN=60
SOCIAL_SYNC_STALE_AFTER_DAYS=7
SOCIAL_SYNC_REFRESH_HOURS=24
CONTACT_FORWARD_TO_PUBLIC_EMAIL=false

# Google sign-in for the site login (identity only). Falls back to the YouTube client below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud OAuth client (YouTube Data API v3 + YouTube Analytics API enabled)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Meta app with "Instagram API with Instagram Login" (Business Login)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# X developer app, OAuth 2.0 confidential client
X_CLIENT_ID=
X_CLIENT_SECRET=
X_BEARER_TOKEN=
