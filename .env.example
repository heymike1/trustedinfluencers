# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain
APP_NAME="Trusted Influencers"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Share image for Open Graph / Twitter (1200×630) and optional @handle for twitter:site
APP_OG_IMAGE=/images/og-default.png
APP_TWITTER_HANDLE=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Production: LOG_LEVEL=warning (or error), LOG_STACK=daily
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (MySQL 8)
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=trustedinfluencers
DB_USERNAME=root
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Sessions, cache, queue
# ---------------------------------------------------------------------------
# All three default to the database so a single MySQL server is enough.
# Production: run `php artisan queue:work` under Supervisor and `php artisan schedule:run`
# every minute from cron. Switch QUEUE_CONNECTION/CACHE_STORE to redis if you have it.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production, behind HTTPS:
# SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# Only needed when QUEUE_CONNECTION or CACHE_STORE is redis
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Mail
# ---------------------------------------------------------------------------
# Sends: contact requests to creators, password reset links.
# Local: MAIL_MAILER=log. Production: smtp (Postmark, Resend, SES, Mailgun...)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# For the postmark/resend mailers instead of smtp:
# POSTMARK_API_KEY=
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Analytics (Datafast). Loaded on every page; leave the id empty to disable.
# ---------------------------------------------------------------------------
DATAFAST_WEBSITE_ID=dfid_mWBEhF5ENbpUJJFPlCs7l
DATAFAST_DOMAIN=trustedinfluencers.co

# ---------------------------------------------------------------------------
# Social connectors
# ---------------------------------------------------------------------------
# fake = everything works offline with a local "sign in as..." screen (no API keys needed)
# live = the official YouTube, Instagram and X APIs using the credentials below
# Production: live
SOCIAL_CONNECTOR_DRIVER=fake

# How many recent videos/posts to import per account. YouTube makes ~2 extra
# Analytics calls per item (retention + daily views), so keep this reasonable.
SOCIAL_SYNC_CONTENT_LIMIT=50
# Minutes between manual "Sync now" clicks by a creator
SOCIAL_SYNC_MANUAL_COOLDOWN=60
# Verified numbers older than this show as "Metrics outdated"
SOCIAL_SYNC_STALE_AFTER_DAYS=7
# The scheduler re-syncs connected accounts this often (hours)
SOCIAL_SYNC_REFRESH_HOURS=24
# Forward contact requests for UNCLAIMED profiles to their submitted public email.
# Off by default: that address was typed in by a third party and is unverified.
CONTACT_FORWARD_TO_PUBLIC_EMAIL=false

# --- Google sign-in (the site login) ---------------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Authorised redirect URI: ${APP_URL}/login/google/callback
# Identity only (openid email profile). Leave empty to reuse the YouTube client below.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- YouTube --------------------------------------------------------------
# Same Google Cloud project, with "YouTube Data API v3" and "YouTube Analytics API" enabled.
# Authorised redirect URI: ${APP_URL}/oauth/youtube/callback
# Scopes requested: youtube.readonly, yt-analytics.readonly (needs OAuth verification for public use)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional API key (no OAuth): lets unclaimed YouTube profiles show public subscriber counts.
YOUTUBE_API_KEY=

# --- Instagram ------------------------------------------------------------
# Meta for Developers > app with "Instagram API with Instagram Login" (Business Login).
# Redirect URI: ${APP_URL}/oauth/instagram/callback
# Permissions: instagram_business_basic, instagram_business_manage_insights (App Review required)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- X --------------------------------------------------------------------
# X Developer Portal > project > app > User authentication settings: OAuth 2.0, confidential client.
# Callback URI: ${APP_URL}/oauth/x/callback
# Scopes: tweet.read users.read offline.access. Reading posts needs a paid API tier.
X_CLIENT_ID=
X_CLIENT_SECRET=
# Optional app-only bearer token: lets unclaimed X profiles show public follower counts.
X_BEARER_TOKEN=
